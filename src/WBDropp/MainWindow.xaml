<Window x:Class="WBDropp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:models="clr-namespace:WBDropp.Models"
        Title="WB Dropp" Width="1120" Height="760" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{StaticResource CanvasBrush}"
        AllowDrop="True" Loaded="Window_Loaded" Closing="Window_Closing"
        DragEnter="Window_DragEnter" DragLeave="Window_DragLeave" Drop="Window_Drop">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="7" CornerRadius="14" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="BadgeStyle" TargetType="Border">
      <Setter Property="Background" Value="#F4F4F2"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="4"/>
      <Setter Property="Background" Value="#EEEDEB"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="PART_Track" ClipToBounds="True">
              <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="2"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate DataType="{x:Type models:ProductPack}">
      <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,0,9">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="42"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="38"/>
          </Grid.ColumnDefinitions>

          <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top">
            <Path Data="M3,5 L9,5 11,7 21,7 21,18 C21,19.1 20.1,20 19,20 L3,20 C1.9,20 1,19.1 1,18 L1,7 C1,5.9 1.9,5 3,5 Z"
                  Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" Fill="Transparent" Width="21" Height="20" Stretch="Uniform"/>
          </Border>

          <StackPanel Grid.Column="1" Margin="8,0,18,0">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding SourcePath}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Summary}" Foreground="#525252" FontSize="11" Margin="0,9,0,0"/>
          </StackPanel>

          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <DockPanel LastChildFill="True" Margin="0,0,0,7">
              <Ellipse Width="6" Height="6" Fill="#A3A3A3" Margin="0,0,7,0" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="#A3A3A3"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsComplete}" Value="True"><Setter Property="Fill" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                      <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Fill" Value="#DC2626"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}"/>
          </StackPanel>

          <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Tag="{Binding}" Click="RemovePack_Click" ToolTip="Убрать пак">
            <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="#A3A3A3" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12"/>
          </Button>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="WindowSurface" BorderBrush="#DEDDDA" BorderThickness="1" CornerRadius="14" Background="{StaticResource CanvasBrush}" Opacity="1">
    <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
      <Grid.RowDefinitions>
        <RowDefinition Height="58"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#FAFAF8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="14,14,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="20,0,10,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="124"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource InkBrush}">
              <Grid>
                <Path Data="M3,3 L13,3 13,13 3,13 Z M6,6 L16,6 16,16 6,16 Z" Stroke="White" StrokeThickness="1.5" Fill="Transparent" Width="16" Height="16" Stretch="Uniform"/>
              </Grid>
            </Border>
            <TextBlock Text="WB Dropp" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <Border Background="#EEEDEB" CornerRadius="5" Padding="6,2" Margin="8,0,0,0">
              <TextBlock Text="0.0.2" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
            </Border>
          </StackPanel>

          <Border Grid.Column="1" Background="#F0EFED" CornerRadius="14" Padding="10,5" VerticalAlignment="Center" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="PhotoshopDot" Width="6" Height="6" Fill="#A3A3A3" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock x:Name="PhotoshopStatusText" Text="Photoshop" FontSize="11" Foreground="#525252"/>
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource IconButtonStyle}" Click="Minimize_Click" Content="—" FontSize="13"/>
            <Button Style="{StaticResource IconButtonStyle}" Click="Maximize_Click" Content="□" FontSize="14"/>
            <Button Style="{StaticResource IconButtonStyle}" Click="Close_Click" Content="×" FontSize="17"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="28,24,28,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,20,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
              <TextBlock Text="Паки товаров" FontSize="24" FontWeight="SemiBold"/>
              <TextBlock x:Name="SummaryText" Text="Добавьте папки с фотографиями" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <Button x:Name="ClearButton" Style="{StaticResource SecondaryButtonStyle}" Content="Очистить" Height="36" Margin="0,0,8,0" Click="Clear_Click" IsEnabled="False"/>
              <Button x:Name="AddFolderButton" Style="{StaticResource SecondaryButtonStyle}" Content="+ Добавить папку" Height="36" Click="AddFolder_Click"/>
            </StackPanel>
          </DockPanel>

          <Border x:Name="DropZone" Grid.Row="1" BorderBrush="#D6D3D1" BorderThickness="1.5" CornerRadius="14" Padding="16" Margin="0,0,0,16" Background="#FBFBFA">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="38" Height="38" Background="#F0EFED" CornerRadius="10">
                <Path Data="M4,4 L10,4 12,7 22,7 22,19 C22,20.1 21.1,21 20,21 L4,21 C2.9,21 2,20.1 2,19 L2,6 C2,4.9 2.9,4 4,4 Z M12,10 L12,17 M8.5,13.5 L15.5,13.5"
                      Stroke="#57534E" StrokeThickness="1.5" Fill="Transparent" Width="22" Height="21" Stretch="Uniform"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Text="Перетащите сюда папки" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Text="Можно сразу несколько — вложенные папки сохранятся" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
              </StackPanel>
            </Grid>
          </Border>

          <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="PackList" ItemsSource="{Binding Packs}"/>
            </ScrollViewer>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0">
              <Border Width="64" Height="64" CornerRadius="20" Background="#EEEDEB">
                <Path Data="M3,5 L9,5 11,7 21,7 21,18 C21,19.1 20.1,20 19,20 L3,20 C1.9,20 1,19.1 1,18 L1,7 C1,5.9 1.9,5 3,5 Z" Stroke="#A8A29E" StrokeThickness="1.4" Fill="Transparent" Width="25" Height="24" Stretch="Uniform"/>
              </Border>
              <TextBlock Text="Здесь появятся ваши паки" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Margin="0,12,0,0"/>
              <TextBlock Text="WB Dropp сам определит формат и крупные кадры" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
          </Grid>
        </Grid>

        <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="18">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
              <TextBlock Text="Результат" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="Куда сохранить обработанные фото" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
              <Border Background="#F0EFED" CornerRadius="10" Padding="3" Margin="0,15,0,0">
                <UniformGrid Columns="2">
                  <RadioButton x:Name="ReplaceMode" GroupName="OutputMode" Content="Заменить" IsChecked="True" Style="{StaticResource SegmentStyle}" Checked="OutputMode_Checked"/>
                  <RadioButton x:Name="FolderMode" GroupName="OutputMode" Content="В папку" Style="{StaticResource SegmentStyle}" Checked="OutputMode_Checked"/>
                </UniformGrid>
              </Border>
            </StackPanel>

            <Border x:Name="OutputFolderPanel" Grid.Row="1" Background="#FAFAF9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="11" Margin="0,12,0,0" Visibility="Collapsed">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Width="32" Height="30" Click="ChooseOutput_Click" ToolTip="Выбрать папку">
                  <TextBlock Text="…" FontSize="18" Margin="0,-5,0,0"/>
                </Button>
                <StackPanel Margin="0,0,8,0">
                  <TextBlock Text="ПАПКА СОХРАНЕНИЯ" FontSize="9" FontWeight="SemiBold" Foreground="#A3A3A3"/>
                  <TextBlock x:Name="OutputPathText" Text="Не выбрана" FontSize="11" Foreground="#525252" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DockPanel>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,20,0,0">
              <TextBlock Text="Автомаршрутизация" FontSize="12" FontWeight="SemiBold"/>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" Fill="#2563EB" VerticalAlignment="Top" Margin="0,4,0,0"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="1400×1050" FontSize="11" FontWeight="SemiBold"/>
                  <TextBlock Text="Кадрирование / крупняк" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" Fill="#7C3AED" VerticalAlignment="Top" Margin="0,4,0,0"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="1000×750 · Legacy" FontSize="11" FontWeight="SemiBold"/>
                  <TextBlock Text="Legacy кадрирование / крупняк" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
              </Grid>
              <Border Background="#FFF7ED" CornerRadius="9" Padding="10" Margin="0,15,0,0">
                <TextBlock Text="Крупный кадр определяется по заполнению кадра и касанию нескольких границ." TextWrapping="Wrap" FontSize="10" Foreground="#9A3412" LineHeight="15"/>
              </Border>
            </StackPanel>

            <Border x:Name="RunNotice" Grid.Row="3" VerticalAlignment="Bottom" Background="#F0FDF4" CornerRadius="10" Padding="11" Margin="0,15,0,12" Visibility="Collapsed">
              <TextBlock x:Name="RunNoticeText" TextWrapping="Wrap" FontSize="11" Foreground="#166534" LineHeight="16"/>
            </Border>

            <StackPanel Grid.Row="4">
              <ProgressBar x:Name="OverallProgress" Minimum="0" Maximum="100" Value="0" Height="5" Margin="0,0,0,10" Visibility="Collapsed"/>
              <Button x:Name="StartButton" Style="{StaticResource PrimaryButtonStyle}" Content="Добавьте папки" IsEnabled="False" Click="Start_Click"/>
              <Button x:Name="CancelButton" Style="{StaticResource SecondaryButtonStyle}" Content="Остановить после текущего фото" Visibility="Collapsed" Margin="0,8,0,0" Click="Cancel_Click"/>
              <TextBlock Text="Photoshop обрабатывает фото по одному — безопасно для actions" TextAlignment="Center" TextWrapping="Wrap" FontSize="9" Foreground="#A3A3A3" Margin="8,10,8,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
